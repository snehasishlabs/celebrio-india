# Celebrio AI - Environment Configuration Example
# Copy this file to .env.local for local overrides.
# Never commit actual credentials or secrets to version control.

# Application Metadata
VITE_APP_NAME="Celebrio AI"
VITE_APP_TAGLINE="Adaptive Celebration & Event Planner"
VITE_APP_VERSION="1.0.0"

# AI Planning Service Mode: 'simulated' | 'openai' | 'gemini' | 'anthropic'
VITE_AI_PROVIDER="simulated"

# Optional External API Keys (Leave blank for simulated/local engine)
VITE_AI_API_KEY=""
VITE_AI_API_BASE_URL=""
