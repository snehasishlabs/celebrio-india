# Celebrio AI - Environment Configuration Example
# Copy this file to .env or .env.local for local overrides.
# NEVER commit actual credentials or secrets to version control.

# Application Metadata (Client-safe)
VITE_APP_NAME="Celebrio AI"
VITE_APP_TAGLINE="Adaptive Celebration & Event Planner"
VITE_APP_VERSION="1.0.0"

# Server-Side Configuration (NEVER prefix with VITE_)
# Server API Port (for standalone Node deployment)
PORT=3001
NODE_ENV="development"

# Google Gemini API Key (Server-side ONLY - Keep secret!)
# When provided, Celebrio AI utilizes live Gemini 2.5 Flash for personalized themes,
# décor concepts, menu creation, and narrative trade-off analysis.
# When omitted, Celebrio AI automatically operates in High-Fidelity Deterministic Demo Mode.
GEMINI_API_KEY=""
